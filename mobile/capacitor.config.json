{
  "appId": "com.hq.qrutils",
  "appName": "HQ 二维码与工具箱",
  "webDir": "../build/web",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#2563EB",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFFFFF"
    },
    "Haptics": {
      "enabled": true
    }
  }
}
