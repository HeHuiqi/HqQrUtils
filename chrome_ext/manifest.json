{
  "manifest_version": 3,
  "name": "HQ 二维码生成器",
  "version": "1.0.0",
  "description": "功能强大的二维码生成与本地历史记录管理工具，支持自定义样式、导出与离线使用。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开二维码生成器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
